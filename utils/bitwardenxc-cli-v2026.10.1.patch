new file mode 100644
index 0000000..b8b4d7f
--- /dev/null
+++ b/apps/cli/src/bitwardenxc-open-cache.ts
@@ -0,0 +1,242 @@
+import { stat } from "node:fs/promises";
+import path from "node:path";
+
+import { firstValueFrom } from "rxjs";
+
+import { AuthenticationStatus } from "@bitwarden/common/auth/enums/authentication-status";
+import { ENCRYPTED_CIPHERS } from "@bitwarden/common/vault/services/key-state/ciphers.state";
+import { FOLDER_ENCRYPTED_FOLDERS } from "@bitwarden/common/vault/services/key-state/folder.state";
+// eslint-disable-next-line no-restricted-imports
+import { SymmetricCryptoKey } from "@bitwarden/legacy-crypto";
+import { PureCrypto } from "@bitwarden/sdk-internal";
+
+import { ListCommand } from "./commands/list.command";
+import { ListResponse } from "./models/response/list.response";
+import { ServiceContainer } from "./service-container/service-container";
+
+const command = "bitwardenxc-open-cache";
+const defaultServer = "https://bitwarden.com";
+const maxRequestBytes = 64 * 1024;
+const maxResponseBytes = 64 * 1024 * 1024;
+
+type Request = {
+  serverUrl: string;
+  email: string;
+  password: string;
+};
+
+export function isCacheOpenInvocation(args: string[]): boolean {
+  return (
+    (args.length === 1 && args[0] === command) ||
+    (args.length === 3 &&
+      args[0] === "--nointeraction" &&
+      args[1] === "--raw" &&
+      args[2] === command)
+  );
+}
+
+export function canonicalServer(input: string): string {
+  const url = new URL(input);
+  if (url.protocol !== "https:" || !url.hostname || input.includes("?") || input.includes("#")) {
+    throw new Error("Invalid cache server");
+  }
+  if (url.username || url.password || /^https:\/\/[^/]*@/i.test(input)) {
+    throw new Error("Invalid cache server");
+  }
+  const address = url.origin + url.pathname.replace(/\/+$/, "");
+  if (address === "https://vault.bitwarden.com") {
+    return defaultServer;
+  }
+  if (address === "https://bitwarden.eu") {
+    return "https://vault.bitwarden.eu";
+  }
+  return address;
+}
+
+export function parseRequest(json: string): Request {
+  const request = JSON.parse(json) as Partial<Request> | null;
+  if (
+    request == null ||
+    Object.keys(request).length !== 3 ||
+    typeof request.serverUrl !== "string" ||
+    typeof request.email !== "string" ||
+    !request.email.trim() ||
+    typeof request.password !== "string" ||
+    !request.password ||
+    request.password.includes("\0")
+  ) {
+    throw new Error("Invalid cache request");
+  }
+  return {
+    serverUrl: canonicalServer(request.serverUrl),
+    email: request.email.trim(),
+    password: request.password,
+  };
+}
+
+async function readRequest(): Promise<Request> {
+  const chunks: Buffer[] = [];
+  let bytes = 0;
+  try {
+    for await (const chunk of process.stdin as AsyncIterable<Buffer>) {
+      chunks.push(chunk);
+      bytes += chunk.byteLength;
+      if (bytes > maxRequestBytes) {
+        throw new Error("Cache request is too large");
+      }
+    }
+    const joined = Buffer.concat(chunks, bytes);
+    try {
+      return parseRequest(new TextDecoder("utf-8", { fatal: true }).decode(joined));
+    } finally {
+      joined.fill(0);
+    }
+  } finally {
+    for (const chunk of chunks) {
+      chunk.fill(0);
+    }
+  }
+}
+
+async function isFile(filename: string): Promise<boolean> {
+  try {
+    return (await stat(filename)).isFile();
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") {
+      return false;
+    }
+    throw error;
+  }
+}
+
+async function openCache(services: ServiceContainer, request: Request): Promise<string> {
+  const account = await firstValueFrom(services.accountService.activeAccount$);
+  if (!account || (await services.authService.getAuthStatus()) === AuthenticationStatus.LoggedOut) {
+    return JSON.stringify({ kind: "unavailable" });
+  }
+
+  const environment = await firstValueFrom(services.environmentService.getEnvironment$(account.id));
+  const serverUrl = canonicalServer(environment.getUrls().base ?? environment.getWebVaultUrl());
+  if (
+    serverUrl !== request.serverUrl ||
+    account.email.toLowerCase() !== request.email.toLowerCase()
+  ) {
+    throw new Error("Cache profile does not match");
+  }
+
+  const [lastSync, encryptedFolders, encryptedItems, unlockData] = await Promise.all([
+    services.syncService.getLastSync(),
+    firstValueFrom(services.stateProvider.getUser(account.id, FOLDER_ENCRYPTED_FOLDERS).state$),
+    firstValueFrom(services.stateProvider.getUser(account.id, ENCRYPTED_CIPHERS).state$),
+    firstValueFrom(services.masterPasswordService.masterPasswordUnlockData$(account.id)),
+  ]);
+  if (
+    !lastSync ||
+    !(lastSync.getTime() > 0) ||
+    encryptedFolders == null ||
+    encryptedItems == null ||
+    !unlockData
+  ) {
+    return JSON.stringify({ kind: "unavailable" });
+  }
+
+  try {
+    await services.unlockService.unlockWithMasterPassword(account.id, request.password);
+  } catch {
+    return JSON.stringify({ kind: "unlockFailed" });
+  } finally {
+    request.password = "";
+  }
+
+  const list = new ListCommand(
+    services.cipherService,
+    services.folderService,
+    services.collectionService,
+    services.organizationService,
+    services.searchService,
+    services.organizationUserApiService,
+    services.apiService,
+    services.eventCollectionService,
+    services.accountService,
+    services.keyService,
+    services.cliRestrictedItemTypesService,
+    services.cipherArchiveService,
+  );
+  const [folderResponse, itemResponse] = await Promise.all([
+    list.run("folders", {}, false),
+    list.run("items", {}, false),
+  ]);
+  if (
+    !folderResponse.success ||
+    !(folderResponse.data instanceof ListResponse) ||
+    !itemResponse.success ||
+    !(itemResponse.data instanceof ListResponse)
+  ) {
+    throw new Error("Cache list failed");
+  }
+
+  const sessionKey = SymmetricCryptoKey.fromSdk(PureCrypto.make_aes256_cbc_hmac_key()).toBase64();
+  const response = JSON.stringify({
+    kind: "opened",
+    serverUrl,
+    email: account.email,
+    sessionKey,
+    folders: folderResponse.data.data,
+    items: itemResponse.data.data,
+  });
+
+  if (Buffer.byteLength(response) >= maxResponseBytes) {
+    return JSON.stringify({ kind: "unavailable" });
+  }
+
+  // Persist only the official CLI's session-encrypted key, after producing the complete response.
+  process.env.BW_SESSION = sessionKey;
+  try {
+    await services.autoUnlockService.refreshAutoUnlockKey(account.id);
+  } catch (error) {
+    await services.stateService.setUserKeyAutoUnlock(null, { userId: account.id });
+    throw error;
+  } finally {
+    delete process.env.BW_SESSION;
+  }
+  return response;
+}
+
+export async function runCacheOpen(): Promise<void> {
+  // Upstream state observables can raise errors outside the command's awaited chain.
+  // Fail this private process without dumping untrusted profile data or stack traces.
+  const exitSilently = () => process.exit(1);
+  process.once("uncaughtException", exitSilently);
+  process.once("unhandledRejection", exitSilently);
+
+  let services: ServiceContainer | undefined;
+  let request: Request | undefined;
+  try {
+    request = await readRequest();
+    const directory = process.env.BITWARDENCLI_APPDATA_DIR;
+    if (!directory || !path.isAbsolute(directory)) {
+      throw new Error("Explicit cache profile required");
+    }
+    if (!(await isFile(path.join(directory, "data.json")))) {
+      process.stdout.write('{"kind":"unavailable"}\n');
+      return;
+    }
+
+    // This is a separate, short-lived invocation. Block any fetch, including accidental
+    // new network dependencies in upstream services, for its entire lifetime.
+    globalThis.fetch = () => Promise.reject(new Error("Network is disabled during cache open"));
+    delete process.env.BW_SESSION;
+    services = new ServiceContainer(true);
+    const initialized = await services.initCacheOpen();
+    const response = initialized ? await openCache(services, request) : '{"kind":"unavailable"}';
+    process.stdout.write(response + "\n");
+  } catch {
+    // Private protocol: never report upstream errors or request data to the console.
+    process.exitCode = 1;
+  } finally {
+    if (request) {
+      request.password = "";
+    }
+    services?.dispose();
+  }
+}
